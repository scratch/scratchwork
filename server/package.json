{
  "name": "scratchwork-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Scratchwork publishing server workspace commands.",
  "scripts": {
    "start": "cd core && bun run start",
    "dev": "cd core && bun run dev",
    "check": "bun run typecheck",
    "deploy:cloudflare": "cd deploy-cloudflare && bun run deploy",
    "typecheck": "cd core && bun run typecheck && cd ../deploy-cloudflare && bun run typecheck"
  }
}
