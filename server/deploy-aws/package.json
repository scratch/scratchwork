{
  "name": "@scratchwork/server-deploy-aws",
  "version": "0.2.0",
  "type": "module",
  "description": "AWS Lambda + S3 deployment package for the Scratchwork server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scratch/scratchwork.git",
    "directory": "server/deploy-aws"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./dynamodb-db": "./src/dynamodb-db.ts",
    "./handler": "./src/handler.ts",
    "./s3-storage": "./src/s3-storage.ts"
  },
  "scripts": {
    "build": "bun build src/handler.ts --target=node --format=esm --outfile=dist/handler.mjs",
    "ci": "bun run typecheck && bun run test && bun run build",
    "deploy": "bun scripts/deploy.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1075.0",
    "@aws-sdk/client-s3": "3.1075.0",
    "@effect/platform": "0.96.2",
    "@scratchwork/server-core": "workspace:*",
    "effect": "3.21.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
