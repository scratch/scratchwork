{
  "name": "scratchwork-cli",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "scratchwork — Bun CLI built with Effect: dev server with hot reload, publishing, example files, and template export.",
  "bin": {
    "scratchwork": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build.js",
    "check": "bun run typecheck && bun test",
    "lint": "bun run typecheck",
    "test": "bun run check",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@effect/cli": "0.75.2",
    "@effect/platform": "0.96.2",
    "@effect/platform-bun": "0.90.0",
    "@effect/printer": "0.49.0",
    "@effect/printer-ansi": "0.49.0",
    "@effect/typeclass": "0.40.0",
    "effect": "3.21.4"
  },
  "files": [
    "assets",
    "example",
    "src"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
