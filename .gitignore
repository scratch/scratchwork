.DS_Store
node_modules/
dist/

# Local environment files. Keep .env.example files committed.
**/.env
**/.env.*
!**/.env.example

# Per-project publish metadata (server-assigned id, name, server). Written by
# `scratchwork publish` into whatever directory you publish; not for committing.
.scratchwork.json

# Local publishing-server data dirs, written by local server runs into the
# deploy project's directory.
.scratchwork-data/
.scratchwork-local-data/
